{
  "name": "RFQ Intake Agent (low-code)",
  "meta": {
    "description": "Low-code build of the RFQ-email -> quote agent. Mirrors the full-code agent in src/agentic_lab: an AI Agent (Tools Agent) that calls the same Python tools over HTTP (agentic_lab.tool_server) to parse the email, resolve SKUs, check stock and draft a quote. Import into n8n, bind an Anthropic credential on the Chat Model, and point the HTTP tools at the running tool server."
  },
  "nodes": [
    {
      "parameters": {},
      "id": "b1a11111-1111-4111-8111-111111111111",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [-40, 260]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are an order-intake agent for an industrial distributor. Given a customer RFQ email, resolve every requested line item to a catalog SKU, check stock, and produce a priced quote. Call tools one step at a time; never invent SKUs or prices - always look them up. When the quote is drafted, summarise it briefly."
        }
      },
      "id": "a2a22222-2222-4222-8222-222222222222",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [280, 260]
    },
    {
      "parameters": {
        "model": "claude-haiku-4-5-20251001",
        "options": {}
      },
      "id": "c3c33333-3333-4333-8333-333333333333",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.2,
      "position": [140, 520],
      "credentials": {
        "anthropicApi": {
          "id": "REBIND_ON_IMPORT",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "fromInput",
        "contextWindowLength": 10
      },
      "id": "d4d44444-4444-4444-8444-444444444444",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [300, 520]
    },
    {
      "parameters": {
        "toolDescription": "Extract the customer and requested line items (description + qty) from a raw RFQ email. Input: raw_email (string).",
        "method": "POST",
        "url": "http://host.docker.internal:8000/parse_email",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"raw_email\": {{ JSON.stringify($fromAI('raw_email', 'the full raw email text', 'string')) }} }",
        "options": {}
      },
      "id": "e5e55555-5555-4555-8555-555555555555",
      "name": "parse_email",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [460, 520]
    },
    {
      "parameters": {
        "toolDescription": "Resolve one free-text line item to the best-matching catalog SKU (with price). Input: description (string).",
        "method": "POST",
        "url": "http://host.docker.internal:8000/lookup_sku",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"description\": {{ JSON.stringify($fromAI('description', 'one line-item description', 'string')) }} }",
        "options": {}
      },
      "id": "f6f66666-6666-4666-8666-666666666666",
      "name": "lookup_sku",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [600, 520]
    },
    {
      "parameters": {
        "toolDescription": "Check availability and lead time for a SKU at a requested quantity. Inputs: sku (string), qty (number).",
        "method": "POST",
        "url": "http://host.docker.internal:8000/check_stock",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"sku\": {{ JSON.stringify($fromAI('sku', 'the catalog SKU', 'string')) }}, \"qty\": {{ $fromAI('qty', 'requested quantity', 'number') }} }",
        "options": {}
      },
      "id": "07077777-7777-4777-8777-777777777777",
      "name": "check_stock",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [740, 520]
    },
    {
      "parameters": {
        "toolDescription": "Build a priced customer quote from resolved line items. Inputs: customer (string), line_items (array of {sku, description, qty, unit_price_eur}).",
        "method": "POST",
        "url": "http://host.docker.internal:8000/draft_quote",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"customer\": {{ JSON.stringify($fromAI('customer', 'customer name', 'string')) }}, \"line_items\": {{ $fromAI('line_items', 'array of resolved line items', 'json') }} }",
        "options": {}
      },
      "id": "18188888-8888-4888-8888-888888888888",
      "name": "draft_quote",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [880, 520]
    }
  ],
  "connections": {
    "When chat message received": {
      "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]]
    },
    "Anthropic Chat Model": {
      "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "Window Buffer Memory": {
      "ai_memory": [[{ "node": "AI Agent", "type": "ai_memory", "index": 0 }]]
    },
    "parse_email": {
      "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]]
    },
    "lookup_sku": {
      "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]]
    },
    "check_stock": {
      "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]]
    },
    "draft_quote": {
      "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
