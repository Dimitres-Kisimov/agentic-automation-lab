# Copy to .env and fill in to run the agent against a real LLM.
# Leave everything blank to run in offline MOCK mode (default, no key needed).

# --- Full-code Python agent ---
# Provider: "mock" (default, deterministic, no key) or "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Model id used when LLM_PROVIDER=anthropic (see docs/DECISION_GUIDE.md for choice rationale)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- n8n low-code stack (docker-compose) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
# n8n binds its own Anthropic/OpenAI credentials in the editor UI (never in the JSON).
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
